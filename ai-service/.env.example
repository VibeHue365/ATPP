GEMINI_API_KEY=replace-with-gemini-api-key
TZ=Asia/Ho_Chi_Minh

# Phai trung ten DB voi MONGODB_URI cua backend (auto-detect tu path URI neu de trong NESTJS_DB_NAME)
# Tren GCP 2 VM (VM 2 ket noi sang MongoDB rs0 tren VM 1 qua Internal VPC):
# BAT BUOC them &directConnection=true de driver khong resolve hostname noi bo "mongodb:27017" cua VM 1.
# Vi du: mongodb://<MONGO_USER>:<MONGO_PASS>@<CORE_INTERNAL_IP>:27017/vibehue?authSource=admin&directConnection=true
MONGO_URL=mongodb://127.0.0.1:27017/vibehue
DB_NAME=aodai_platform
NESTJS_DB_NAME=vibehue

# Tren GCP 2 VM: BACKEND_URL=https://api.tenmien.id.vn (hoac http://<CORE_INTERNAL_IP>:3000), FRONTEND_URL=https://tenmien.id.vn
BACKEND_URL=http://host.docker.internal:3000
FRONTEND_URL=http://host.docker.internal:5173

VISUAL_SEARCH_ENABLED=true
PRODUCT_DRAFT_ENABLED=true
PRODUCT_DRAFT_GEMINI_ENABLED=true
# Tuy chon: dung API key rieng cho product draft de tranh chung quota voi chatbot
# PRODUCT_DRAFT_GEMINI_API_KEY=
PRODUCT_DRAFT_GEMINI_MODEL=gemini-3.1-flash-lite
SIZE_CHART_GEMINI_MODEL=gemini-3.1-flash-lite
SIZE_CHART_GEMINI_FALLBACK_MODEL=gemini-3.6-flash
