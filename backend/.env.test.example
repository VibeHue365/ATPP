NODE_ENV=test
MONGODB_URI=mongodb://127.0.0.1:27017/vibehue_test
FRONTEND_URL=http://localhost:5173
JWT_SECRET=test-only-jwt-secret-not-for-production
BCRYPT_SALT_ROUNDS=10
POLICY_ACTIVATION_MODE=COMPENSATION
DISABLE_AUTO_CREATE_INVENTORY=true
SMART_TAG_AI_ENABLED=false

# Opt-in concurrency E2E only. The URI must point to a disposable MongoDB
# replica set; the test creates and drops its own timestamped database.
RUN_PHOTOGRAPHY_HOLD_E2E=false
MONGODB_HOLD_TEST_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
