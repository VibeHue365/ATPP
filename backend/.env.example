NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/vibehue
FRONTEND_URL=http://localhost:5173
BODY_LIMIT=1mb
POLICY_ACTIVATION_MODE=COMPENSATION

JWT_SECRET=replace-with-a-long-random-secret
BCRYPT_SALT_ROUNDS=12

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM=VibeHue <no-reply@example.com>

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123
BOOTSTRAP_ADMIN_NAME=Bootstrap Admin

# Chan viec tu dong sinh hien vat ton kho khi khach dat ma kho rong.
# BAT BUOC de "true", neu khong bien the vua xoa se tu tao lai khi co nguoi dat.
DISABLE_AUTO_CREATE_INVENTORY=true
