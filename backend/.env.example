NODE_ENV=development
PORT=3000
TZ=Asia/Ho_Chi_Minh
MONGODB_URI=mongodb://127.0.0.1:27017/vibehue
REDIS_URL=redis://127.0.0.1:6379
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
BODY_LIMIT=10mb
POLICY_ACTIVATION_MODE=COMPENSATION

# Rate limit (tang len 600 / 300 tren production de tranh 429 khi nhieu may dung chung Wi-Fi)
THROTTLE_DEFAULT_LIMIT=600
THROTTLE_AUTH_LIMIT=300

JWT_SECRET=replace-with-a-long-random-secret
IDENTITY_FINGERPRINT_SECRET=replace-with-a-separate-long-random-secret
BCRYPT_SALT_ROUNDS=12

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_ANDROID_CLIENT_ID=replace-with-google-android-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM=TàGo <no-reply@example.com>

# Public media storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Private KYC & contract PDF storage (MinIO)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=vibehue_minio
MINIO_SECRET_KEY=vibehue_minio_password
MINIO_PROVIDER_DOCUMENT_BUCKET=provider-documents
MINIO_AUTO_CREATE_BUCKETS=true

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123
BOOTSTRAP_ADMIN_NAME=Bootstrap Admin

# Chan viec tu dong sinh hien vat ton kho khi khach dat ma kho rong.
# BAT BUOC de "true", neu khong bien the vua xoa se tu tao lai khi co nguoi dat.
DISABLE_AUTO_CREATE_INVENTORY=true

# Internal AI & OCR services (tren GCP 2 VM: dung Internal IP cua VM tago-ai)
AI_SERVICE_URL=http://127.0.0.1:8000
OCR_SERVICE_URL=http://127.0.0.1:8010
SMART_TAG_AI_ENABLED=true
SMART_TAG_AI_TIMEOUT_MS=15000

# Thanh toan & tinh nang demo do an
ENABLE_PAYMENT_SIMULATOR=true
PAYOS_REFUND_MOCK=true
ALLOW_EARLY_RENTAL_PICKUP=true
# Bat "true" khi can demo nut gia lap don qua han/Domino tren production (mac dinh nen de false)
ALLOW_OVERDUE_SIMULATION=false
CONTRACTS_V2_ENABLED=false
CONTRACTS_TIERED_ENABLED=false
