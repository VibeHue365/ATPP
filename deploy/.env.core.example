# Copy file nay thanh deploy/.env.core tren VM 1 (tago-core) va dien gia tri that.
# TUYET DOI KHONG commit file deploy/.env.core len Git.

# Ten mien API tro ve External IP tinh cua VM 1 (vi du: api.tago.id.vn)
API_DOMAIN=api.tago.id.vn

# Tai khoan root MongoDB 7 (phai trung voi MONGODB_URI trong backend/.env va MONGO_URL trong ai-service/.env)
# Chi nen dung chu va so (tranh @ : / ? # %) de khong phai URL-encode trong connection string
MONGO_ROOT_USER=tago_admin
MONGO_ROOT_PASSWORD=ChangeMeMongoStrong2026
MONGO_DB_NAME=vibehue

# Tai khoan MinIO (phai trung voi MINIO_ACCESS_KEY & MINIO_SECRET_KEY trong backend/.env)
MINIO_ROOT_USER=tago_minio_admin
MINIO_ROOT_PASSWORD=ChangeMeMinioStrong2026
